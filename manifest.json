{
  "manifest_version": 3,
  "name": "FocusTab",
  "version": "1.0.0",
  "description": "Tab Manager, Reading Mode, and Pomodoro Focus Timer — all in one extension.",

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background/background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js":  ["content/content.js"],
      "css": ["content/reading.css"],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "notifications",
    "scripting"
  ],

  "host_permissions": [
    "<all_urls>"
  ]
}