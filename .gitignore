# ─────────────────────────────────────────
# FocusTab — .gitignore
# ─────────────────────────────────────────

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# Editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# Logs
*.log
npm-debug.log*

# Dependency directories
node_modules/

# Build output (if you ever add a build step)
dist/
build/
out/

# Environment files
.env
.env.local

# Chrome extension packaging output
*.crx
*.pem
*.zip

# Temp files
*.tmp
*.temp
